# Server-only Edge Function secrets; never add a VITE_ prefix or commit a value.
# Each installation supplies its own values. See docs/configure-services.md.
# At least 32 cryptographically random bytes, encoded as hex. No default exists.
MISE_STAFF_PIN_PEPPER_V1=
# New server secret API key (sb_secret_...), supplied only to Edge Functions.
MISE_SERVICE_API_KEY=
# Publishable key used with the original caller JWT for owner/manager RPCs.
MISE_PUBLISHABLE_API_KEY=
# Exact browser origins, comma-separated; no wildcard or trailing slash.
MISE_ALLOWED_ORIGINS=

# Optional installation-wide and per-link read budgets per fixed server minute.
# Empty uses 3000 and 60 respectively; accepted range is 1..60000. Not secrets.
MISE_PUBLIC_READS_PER_MINUTE=
MISE_PUBLIC_LINK_READS_PER_MINUTE=

# Unfinished public ordering is disabled unless the installer explicitly sets true.
MISE_PUBLIC_ORDERS_ENABLED=false
# Empty uses 300 HTTP admissions and 30 new attempts per shop/server minute.
# Existing original attempts can be inspected/retried at the shop limit.
MISE_PUBLIC_ORDERS_PER_MINUTE=
MISE_PUBLIC_SHOP_ORDERS_PER_MINUTE=
# Optional, separate checkout reads/actions per server minute: default 300 global / 30 per order link.
MISE_PUBLIC_CONFIRMATIONS_PER_MINUTE=
MISE_PUBLIC_LINK_CONFIRMATIONS_PER_MINUTE=
MISE_STAFF_LINKS_ENABLED=false
MISE_PUBLIC_STAFF_REQUESTS_PER_MINUTE=
MISE_PUBLIC_STAFF_LINK_REQUESTS_PER_MINUTE=
# Own attendance on a paired browser screen. Each installer opts in privately.
MISE_STAFF_DEVICE_ENABLED=false
# Optional requests per device/server minute, default 600; accepted 1..60000.
MISE_STAFF_DEVICE_REQUESTS_PER_MINUTE=
# Scoped stock reads on an enrolled screen, separately disabled by default.
# The reviewed quantity-write and shared-screen UI work is still unfinished.
MISE_STAFF_STOCK_ENABLED=false
MISE_STAFF_STOCK_WRITES_ENABLED=false
# Optional requests per device/server minute: default 600, accepted 1..60000.
MISE_STAFF_STOCK_REQUESTS_PER_MINUTE=

# Dedicated server-only HMAC key: 32 random bytes encoded as 64 lowercase hex characters.
MISE_SYNC_CURSOR_KEY_V1=

# Reserved server-only values for the remaining M32 alarm and Web Push work.
# The local credential guard checks actual values before any key is generated.
MISE_KITCHEN_ALARM_KEY=
MISE_WEB_PUSH_VAPID_PUBLIC_KEY=
MISE_WEB_PUSH_VAPID_PRIVATE_KEY=
# HTTPS contact page; the product does not use email.
MISE_WEB_PUSH_VAPID_SUBJECT=
MISE_CUSTOMER_KHATA_ENABLED=false
MISE_PUBLIC_KHATA_REQUESTS_PER_MINUTE=3000
MISE_PUBLIC_KHATA_LINK_REQUESTS_PER_MINUTE=60

# Explicit general urgent Inbox consent and delivery. Configure on each backend.
MISE_URGENT_INBOX_ENABLED=false
# Dedicated 32 random bytes encoded as 43 unpadded base64url characters.
# Keep the identical value in private Vault for signed one-use scheduler proofs.
MISE_URGENT_INBOX_KEY=

# native-original-copy reuses SUPABASE_URL, MISE_PUBLISHABLE_API_KEY and
# MISE_ALLOWED_ORIGINS above. Each installation configures its own backend.
# It requires no service/administrator key and has no maintainer-owned account.
