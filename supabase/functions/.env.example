# Server-only Edge Function secrets; never add a VITE_ prefix or commit a value.
# Each installation supplies its own values. See docs/configure-services.md.
# At least 32 cryptographically random bytes, encoded as hex. No default exists.
MISE_STAFF_PIN_PEPPER_V1=
# New server secret API key (sb_secret_...), supplied only to Edge Functions.
MISE_SERVICE_API_KEY=
# Publishable key used with the original caller JWT for owner/manager RPCs.
MISE_PUBLISHABLE_API_KEY=
# Exact browser origins, comma-separated; no wildcard or trailing slash.
MISE_ALLOWED_ORIGINS=

# Optional installation-wide and per-link read budgets per fixed server minute.
# Empty uses 3000 and 60 respectively; accepted range is 1..60000. Not secrets.
MISE_PUBLIC_READS_PER_MINUTE=
MISE_PUBLIC_LINK_READS_PER_MINUTE=

# Dedicated server-only HMAC key: 32 random bytes encoded as 64 lowercase hex characters.
MISE_SYNC_CURSOR_KEY_V1=

# Reserved server-only values for the remaining M32 alarm and Web Push work.
# The local credential guard checks actual values before any key is generated.
MISE_KITCHEN_ALARM_KEY=
MISE_WEB_PUSH_VAPID_PUBLIC_KEY=
MISE_WEB_PUSH_VAPID_PRIVATE_KEY=
# HTTPS contact page; the product does not use email.
MISE_WEB_PUSH_VAPID_SUBJECT=
