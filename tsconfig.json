{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "esModuleInterop": true, "types": ["node"]
  },
  "include": ["apps/web/src", "apps/web/vite.config.ts", "packages/**/*.ts", "packages/**/*.tsx", "tests/**/*.ts", "playwright.config.ts", "vitest.config.ts"]
}
