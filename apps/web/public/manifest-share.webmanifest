{
  "id": "./",
  "name": "Mise",
  "short_name": "Mise",
  "description": "Sales, orders, khata and stock, saved on this device and available offline.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./inbox?flags=shareTarget",
  "scope": "./",
  "display": "standalone",
  "theme_color": "#141414",
  "background_color": "#f5f5f4",
  "share_target": {
    "action": "./inbox/receive",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "images",
          "accept": [
            "image/jpeg",
            "image/png",
            "image/webp"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
