---
import '@mise/ui/tokens.css';
import '@mise/ui/fonts.css';
import '@mise/ui/primitives.css';
import '../styles/global.css';
import geistRegular from '../../../../packages/ui/node_modules/@fontsource/geist/files/geist-latin-400-normal.woff2?url';
import geistSemibold from '../../../../packages/ui/node_modules/@fontsource/geist/files/geist-latin-600-normal.woff2?url';
interface Props { title: string; description: string; lang?: string; region?: 'bd' | 'intl'; noindex?: boolean }
const { title, description, lang = 'en', region, noindex } = Astro.props;
const base = import.meta.env.BASE_URL;
const origin = Astro.site || new URL('https://tanzir71.github.io');
const url = (path: string) => new URL(`${base}${path}`, origin).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111111" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="icon" href={`${base}brand/icons/favicon.ico`} sizes="any" />
    <link rel="apple-touch-icon" href={`${base}brand/icons/apple-touch-icon-180.png`} />
    <link rel="preload" href={geistRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistSemibold} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={new URL(Astro.url.pathname, origin).href} />
    <link rel="alternate" hreflang="en-BD" href={url('bd/')} />
    <link rel="alternate" hreflang="en" href={url('intl/')} />
    <link rel="alternate" hreflang="x-default" href={url('')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, origin).href} />
    <meta property="og:site_name" content="Mise" />
    <meta property="og:locale" content={region === 'bd' ? 'en_BD' : 'en_US'} />
    <meta property="og:image" content={url(`og-${region || 'intl'}.png`)} />
    <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <dialog id="availability" class="availability"><div><p class="eyebrow">LET’S GET YOU READY</p><h2>We’re getting Mise ready.</h2><p>The working app is coming in the next phase. Explore setup and the rollout plan while we get the counter ready.</p><a class="button button-primary" href={`${base}setup/`}>See setup and downloads <span aria-hidden="true">→</span></a><form method="dialog"><button class="button button-secondary">Close</button></form></div></dialog>
    <script>
      document.querySelectorAll<HTMLAnchorElement>('[data-unconfigured]').forEach(link => link.addEventListener('click', event => { event.preventDefault(); document.querySelector<HTMLDialogElement>('#availability')?.showModal(); }));
      document.querySelectorAll<HTMLAnchorElement>('[data-region]').forEach(link => link.addEventListener('click', () => { try { localStorage.setItem('mise.region', link.dataset.region || 'intl'); } catch { /* Navigation works without storage. */ } }));
    </script>
  </body>
</html>
