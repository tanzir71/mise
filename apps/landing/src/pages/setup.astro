---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import DownloadCard from '../components/DownloadCard.astro';
import Icon from '@mise/ui/Icon.astro';
import landing from '../../../../handover/copy/landing.bd.json';
import c from '../../../../handover/copy/setup.json';
import '../styles/landing.css';
import '../styles/setup.css';
const base = import.meta.env.BASE_URL;
const appUrl = import.meta.env.PUBLIC_APP_URL || (import.meta.env.DEV ? `http://127.0.0.1:5173${base}app/` : `${base}app/`);
const repo = (import.meta.env.PUBLIC_REPO_URL || 'https://github.com/tanzir71/mise').replace(/\/$/, '');
const nav = { ...landing.nav, cta: c.nav.cta, links: [ { label: c.nav.product, href: `${base}bd/` }, { label: c.nav.setup, href: `${base}setup/` }, { label: c.nav.releases, href: `${repo}/releases` } ] };
const deploy = `https://vercel.com/new/clone?${new URLSearchParams({ 'repository-url': repo, 'project-name': 'mise', 'repository-name': 'mise' })}`;
const prompt = c.selfHost.prompt.replace('{repo}', repo);
const orderPhone = c.devices.find(d => d.id === 'order-phone')!;
---
<Base title={c.meta.title} description={c.meta.description}>
  <div class="setup-header"><Header nav={nav} appUrl={appUrl} home={`${base}bd/`} showSignIn={false} /></div>
  <main id="main" class="setup-page" data-base={base} data-repo={repo} data-download-copy={JSON.stringify(c.availability)}>
    <div class="setup-phone container">
      <h1>{c.phone.title}</h1><p class="phone-lead">{c.phone.lead}</p>
      <DownloadCard device={orderPhone} appUrl={appUrl} compact />
      <p class="phone-manifest-status" role="status" data-mobile-manifest-status></p><button class="copy-link" data-phone-retry hidden>{c.availability.retry}</button>
      <ol class="phone-steps">{c.phone.steps.map((step, i) => <li><span class="step-number">{i + 1}</span><div><h2>{step.title}</h2><p>{step.text}</p></div></li>)}</ol>
      <aside class="phone-self-host"><h2><Icon name="sparkles" size={18} />{c.phone.selfHostTitle}</h2><p>{c.phone.selfHostText} <a href="#vercel">{new URL(`${base}setup/#vercel`, Astro.site).href}</a></p></aside>
      <p class="phone-help">{c.phone.help}</p>
    </div>
    <details class="setup-all-devices container">
      <summary>{c.common.allDevices}<Icon name="chevronDown" size={18} /></summary>
      <div class="setup-desktop">
        <section class="setup-hero"><p class="eyebrow">{c.hero.eyebrow}</p><h1>{c.hero.title}</h1><p class="lead">{c.hero.lead}</p><div class="setup-release"><p id="manifest-status" role="status">{c.availability.checking}</p><button id="manifest-retry" class="copy-link" hidden>{c.availability.retry}</button><a class="button button-secondary" href={`${repo}/releases`}><Icon name="external" size={17} />{c.hero.releases}</a></div></section>
        <section id="downloads" aria-label={c.common.allDevices}>
          <div class="downloads-grid">{c.devices.map(device => <DownloadCard device={device} appUrl={appUrl} />)}</div>
          <p class="setup-preview-note">{c.availability.preview}</p>
          <noscript><p><a href={`${base}downloads/manifest.json`}>{c.availability.manifest}</a> · <a href={`${repo}/tree/main/downloads`}>{c.availability.repository}</a></p></noscript>
        </section>
        <section id="install" class="installation-guides" aria-label={c.common.instructions}>
          {c.guides.map(guide => <article id={guide.id} class="install-guide"><h2>{guide.title}</h2><p>{guide.lead}</p><ol class="setup-steps">{guide.steps.map((step, i) => <li><span class="step-number">{i + 1}</span><div><h3>{step.title}</h3><p>{step.text}</p>{'code' in step && <pre class="command"><code>{step.code}</code></pre>}{'example' in step && <div class:list={['instruction-example', { 'notification-example': step.example === 'notifications' }]} aria-label={c.examples.label}>
            {step.example === 'developer' && <><span>{c.examples.extensions}</span><span class="example-setting">{c.examples.developer}<span class="example-toggle" role="img" aria-label={c.examples.on}></span></span></>}
            {step.example === 'source' && <><span>{c.examples.source}</span><span class="example-toggle" role="img" aria-label={c.examples.on}></span></>}
            {step.example === 'unpacked' && c.examples.unpacked.map(label => <span class="example-button">{label}</span>)}
            {step.example === 'notifications' && c.examples.notifications.map((label, index) => <span class="example-setting">{label}<span class:list={['example-toggle', { off: index === 3 }]} role="img" aria-label={index === 3 ? c.examples.off : c.examples.on}></span></span>)}
          </div>}</div></li>)}</ol></article>)}
        </section>
        <section class="setup-helpers" aria-label={c.helpers.updates.title}>
          {[c.helpers.cable, c.helpers.checksum].map((helper, i) => <article id={i === 0 ? 'cable' : 'checksums'}><h2>{helper.title}</h2><p>{helper.text}</p><div class="command"><code>{helper.command}</code><button class="copy-link" data-copy={helper.command} aria-label={`${c.common.copy} ${helper.title}`}><Icon name="copy" size={16} /></button></div></article>)}
          <article id="updates"><h2>{c.helpers.updates.title}</h2><p>{c.helpers.updates.text}</p><ul>{c.helpers.updates.items.map(item => <li><Icon name="refreshCw" size={16} /><span>{item}</span></li>)}</ul></article>
        </section>
        <div class="browser-guides">{c.browserGuides.map(guide => <details id={guide.id}><summary>{guide.title}<Icon name="chevronDown" size={16} /></summary><p>{guide.text}</p><ol>{guide.steps.map(step => <li>{step}</li>)}</ol><a href={appUrl} class="text-link">{c.nav.cta}<Icon name="external" size={14} /></a></details>)}</div>
        <section id="vercel" class="vercel-section"><p class="eyebrow">{c.selfHost.eyebrow}</p><h2>{c.selfHost.title}</h2><p class="vercel-lead">{c.selfHost.lead}</p><div class="vercel-grid">
          <article class="agent-deploy-card"><h3><Icon name="sparkles" size={20} />{c.selfHost.agentTitle}</h3><p>{c.selfHost.agentLead}</p><ol class="setup-steps">{c.selfHost.steps.map((step, i) => <li><span class="step-number">{i + 1}</span><div><h4>{i === 0 ? <a href={`${repo}/fork`}>{step.title}</a> : step.title}</h4><p>{step.text}</p></div></li>)}</ol><div class="agent-prompt"><div><label for="agent-prompt">{c.common.prompt}</label><button class="copy-link" data-copy-source="#agent-prompt" aria-label={c.common.copyPrompt}><Icon name="copy" size={18} /></button></div><textarea id="agent-prompt" readonly rows="10">{prompt}</textarea></div><a href={`${base}docs/deploy-own-vercel.md`} class="text-link">{c.common.fullGuide}<Icon name="arrowUpRight" size={14} /></a></article>
          <article class="manual-deploy-card"><h3>{c.selfHost.manualTitle}</h3><p>{c.selfHost.manualLead}</p><a href={deploy} class="button button-primary" target="_blank" rel="noreferrer"><Icon name="external" size={17} />{c.selfHost.deploy}</a><ul>{c.selfHost.benefits.map(benefit => <li><Icon name={benefit.icon} size={18} /><div><h4>{benefit.title}</h4><p>{benefit.text}</p></div></li>)}</ul></article>
        </div></section>
        <section class="setup-troubleshooting"><h2>{c.troubleshooting.title}</h2><div>{c.troubleshooting.items.map(item => <article><h3><Icon name="triangleAlert" size={16} />{item.title}</h3><p>{item.text}</p></article>)}</div></section>
        <p class="setup-manifest-link"><a href={`${base}downloads/manifest.json`}>{c.availability.manifest}</a> · <a href={`${repo}/tree/main/downloads`}>{c.availability.repository}</a></p>
      </div>
    </details>
  </main>
</Base>
<script>
  import { parseDownloadsManifest, formatBytes } from '@mise/core/downloads';
  const host = document.querySelector<HTMLElement>('.setup-page')!;
  const status = document.querySelector<HTMLElement>('#manifest-status')!;
  const retry = document.querySelector<HTMLButtonElement>('#manifest-retry')!;
  const phoneRetry = document.querySelector<HTMLButtonElement>('[data-phone-retry]')!;
  const phoneStatus = document.querySelector<HTMLElement>('[data-mobile-manifest-status]')!;
  const labels = JSON.parse(host.dataset.downloadCopy!) as Record<string, string>;
  const allDevices = document.querySelector<HTMLDetailsElement>('.setup-all-devices')!;
  const desktop = window.matchMedia('(min-width: 768px)');
  const showGuides = () => { allDevices.open = desktop.matches || Boolean(location.hash); allDevices.toggleAttribute('data-desktop-open', desktop.matches); };
  showGuides(); desktop.addEventListener('change', showGuides);
  const revealHash = () => {
    const target = document.getElementById(location.hash.slice(1));
    if (!target) return;
    allDevices.open = true;
    if (target instanceof HTMLDetailsElement) target.open = true;
    target.scrollIntoView();
  };
  window.addEventListener('hashchange', revealHash);
  if (location.hash) revealHash();
  async function loadManifest() {
    retry.hidden = true; phoneRetry.hidden = true; status.textContent = labels.checking; phoneStatus.textContent = '';
    const controller = new AbortController(); const timeout = setTimeout(() => controller.abort(), 5000);
    try {
      const response = await fetch(`${host.dataset.base}downloads/manifest.json`, { cache: 'no-store', signal: controller.signal });
      if (!response.ok) throw new Error('Download list unavailable');
      const manifest = parseDownloadsManifest(await response.json());
      for (const item of manifest.items) {
        for (const card of document.querySelectorAll<HTMLElement>(`[data-download="${item.id}"]`)) {
          card.querySelector<HTMLElement>('.device-availability')!.hidden = true;
          const text = (selector: string, value: string) => { card.querySelector<HTMLElement>(selector)!.textContent = value; };
          text('[data-version]', `v${item.version}`); text('[data-size]', formatBytes(item.bytes));
          text('[data-date]', manifest.updatedAt ? new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(manifest.updatedAt)) : labels.latest);
          text('[data-checksum]', item.sha256); text('[data-requirements]', [item.minAndroid && `Android ${item.minAndroid}+`, item.minApp && `Mise ${item.minApp}+`].filter(Boolean).join(' · '));
          card.querySelector<HTMLElement>('.download-meta')!.hidden = false;
          card.querySelector<HTMLElement>('[data-coming]')!.hidden = true;
          card.querySelector<HTMLElement>('.checksum')!.hidden = false;
          card.querySelector<HTMLButtonElement>('[data-copy]')!.dataset.copy = item.sha256;
          const download = card.querySelector<HTMLAnchorElement>('.download-link')!; download.href = `${host.dataset.base}downloads/${item.latest}`; download.hidden = false;
          const source = card.querySelector<HTMLAnchorElement>('.repo-link')!; source.href = `${host.dataset.repo}/blob/main/downloads/${item.file}`; source.hidden = false;
        }
      }
      status.textContent = manifest.items.length ? `${manifest.items.length} ${labels.count}` : labels.empty;
    } catch { status.textContent = labels.error; phoneStatus.textContent = labels.error; retry.hidden = false; phoneRetry.hidden = false; }
    finally { clearTimeout(timeout); }
  }
  retry.addEventListener('click', () => void loadManifest());
  phoneRetry.addEventListener('click', () => void loadManifest());
  void loadManifest();
</script>
