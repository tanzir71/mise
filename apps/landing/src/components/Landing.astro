---
import type bdCopy from '../../../../handover/copy/landing.bd.json';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Heading from './SectionHeading.astro';
import Shot from './Shot.astro';
import Icon from '@mise/ui/Icon.astro';
import Section from '@mise/ui/Section.astro';
import Chip from '@mise/ui/Chip.astro';
import '../styles/landing.css';
import '../styles/hero.css';
import '../styles/product-sections.css';
interface Props { copy: typeof bdCopy }
const { copy: c } = Astro.props;
const base = import.meta.env.BASE_URL;
const appUrl = import.meta.env.PUBLIC_APP_URL || (import.meta.env.DEV ? `http://127.0.0.1:5173${base}app/` : `${base}app/`);
const secondaryUrl = c.region === 'bd' ? import.meta.env.PUBLIC_WHATSAPP_URL : import.meta.env.PUBLIC_DEMO_URL;
const contactUrl = import.meta.env.PUBLIC_WHATSAPP_URL;
const region = c.region as 'bd' | 'intl';
const numberedSlot = (group: string, index: number) => `${group}.${String(index + 1).padStart(2, '0')}`;
---
<Base title={c.meta.title} description={c.meta.description} lang={c.lang} region={c.region as 'bd' | 'intl'}>
  <Header nav={c.nav} appUrl={appUrl} />
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-copy"><h1 id="hero-title">{c.hero.headline}</h1><p class="hero-lead">{c.hero.lead}</p><div class="hero-actions"><a class="button button-primary" href={appUrl}>{c.hero.ctaPrimary}</a><a class="button hero-secondary" href="#day"><Icon name="zap" size={16} />{c.hero.ctaSecondary}</a></div><p class="hero-trust">{c.hero.trustLine}</p></div>
        <div class="hero-visual"><Shot region={region} imageSlot="hero.visual" eager sizes="(max-width: 767px) 240px, (max-width: 1023px) 260px, 359.5px" /></div>
      </div>
    </section>
    <section id="features" class="feature-index"><div class="container"><p class="eyebrow">{c.index.label}</p><div class="index-pills">{c.index.items.map(item=><Chip href={item.href} selected={item.highlight}><Icon name={item.icon} size={16} />{item.label}</Chip>)}</div></div></section>
    <Section id="ai">
      <Heading eyebrow={c.ai.eyebrow} headline={c.ai.headline} lead={c.ai.lead} />
      <div class="ai-grid"><div class="permissions-card">{c.ai.permissions.map(row=><div class="permission-row"><div><h3>{row.title}</h3><p>{row.meta}</p></div><div class="segmented" aria-label={`${row.title}: ${row.level}`}>{['Watch','Ask','Alone'].map(level=><span class:list={[{ active:level===row.level }]}>{level}</span>)}</div></div>)}</div><div class="benefits">{c.ai.benefits.map(benefit=><div class="benefit"><span class="line-icon"><Icon name={benefit.icon} size={22} /></span><div><h3>{benefit.title}</h3><p>{benefit.text}</p></div></div>)}</div></div>
      <div class="timeline dark"><h3>{c.ai.timelineTitle}</h3><div class="timeline-grid">{c.ai.timeline.map(step=><div><span class="timeline-node" aria-hidden="true" /><span class="timeline-time">{step.time}</span><h4>{step.title}</h4><p>{step.text}</p></div>)}</div></div>
      <div class="agent-bottom"><div class="failure-ladder"><h3>{c.ai.failureTitle}</h3><div class="ladder-steps">{c.ai.failureSteps.map((step,i)=><Fragment><span class="ladder-step"><b>{i+1}</b>{step}</span>{i<3&&<Icon name="arrowRight" size={18} />}</Fragment>)}</div><p>{c.ai.failureText}</p></div>
      <div class="connect-panel"><h3>{c.ai.connectTitle}</h3><pre><code>{c.ai.connectCode.join('\n')}</code></pre><p>{c.ai.connectText}</p></div></div>
    </Section>
    <Section id="ocr" muted>
      <Heading eyebrow={c.ocr.eyebrow} headline={c.ocr.headline} lead={c.ocr.lead} />
      <div class="ocr-grid">{c.ocr.cards.map((card,i)=><article class="ocr-card"><div class="ocr-flow"><div class:list={['ocr-input',`ocr-input-${i}`]}>{card.input.map(line=><p>{line}</p>)}</div><span class="flow-arrow"><Icon name="arrowRight" size={18} /></span><div class="ocr-output">{card.output.map(([label,value])=><div><span>{label}</span><strong>{value}</strong></div>)}</div></div><h3>{card.title}</h3><p class="ocr-note">{card.note}</p></article>)}</div>
    </Section>
    <Section id="capture" dark>
      <Heading eyebrow={c.capture.eyebrow} headline={c.capture.headline} lead={c.capture.lead} />
      <div class="capture-table"><div class="capture-head">{c.capture.columns.map(label=><span>{label}</span>)}</div>{c.capture.rows.map(row=><div class="capture-row"><div class="capture-source"><span class="capture-icon"><Icon name={row.icon} size={20} /></span><div><h3>{row.source}</h3><p>{row.examples}</p></div></div><Icon name="arrowRight" size={18} /><p class="capture-method">{row.method}</p><Icon name="arrowRight" size={18} /><div class="capture-results">{row.result.map(result=><span>{result}</span>)}</div></div>)}</div><p class="capture-fallback"><Icon name="check" size={18} />{c.capture.fallback}</p>
    </Section>
    <Section id="checks">
      <Heading eyebrow={c.checks.eyebrow} headline={c.checks.headline} lead={c.checks.lead} />
      <div class="checks-grid">{c.checks.items.map(item=><article class="check-card"><div class="check-card-top"><span>{item.tag}</span><Icon name={item.icon} size={20} /></div><div class="when"><span>When</span><h3>{item.when}</h3></div><div class="then"><div><span>Mise</span><p>{item.then}</p></div></div></article>)}</div>
    </Section>
    <Section id="detail" class="detail-section">
      <Heading eyebrow={c.detail.eyebrow} headline={c.detail.headline} lead={c.detail.lead} />
      <div class="detail-blocks">{c.detail.blocks.map((block,i)=><article id={block.id} class:list={['detail-block', { reverse:i%2===1 }]}><div class="detail-visual"><Shot region={region} imageSlot={numberedSlot('detail', i)} /></div><div class="detail-copy"><p class="eyebrow">{block.n} · {block.cat}</p><h3>{block.title}</h3><p class="lead">{block.lead}</p><ol>{block.steps.map((step,index)=><li><span>{index+1}</span><p>{step}</p></li>)}</ol><div class="fallback-box"><Icon name="alert" size={16} /><p>{c.detail.failLabel} {block.fail}</p></div></div></article>)}</div>
    </Section>
    <Section id="day" dark>
      <Heading eyebrow={c.day.eyebrow} headline={c.day.headline} lead={c.day.lead} />
      <div class="day-shots" tabindex="0" role="region" aria-label="A day with Mise product images">{c.day.items.map((item,i)=><figure><div class="day-visual"><Shot region={region} imageSlot={numberedSlot('day', i)} sizes="(max-width: 767px) 200px, 235.5px" /></div><figcaption><span>{item.time}</span><p>{item.text}</p></figcaption></figure>)}</div>
    </Section>
    <Section id="businesses">
      <Heading eyebrow={c.businesses.eyebrow} headline={c.businesses.headline} />
      <div class="business-grid">{c.businesses.items.map((item,i)=><article id={`business-${item.title.toLowerCase().replaceAll(' ','-')}`} class="business-card"><div class="business-shot"><Shot region={region} imageSlot={numberedSlot('businesses', i)} sizes="251px" /></div><div class="business-copy"><h3>{item.title}</h3><ul>{item.points.map(point=><li><Icon name="check" size={16} /><span>{point}</span></li>)}</ul></div></article>)}</div>
    </Section>
    <Section id="basics" muted>
      <Heading eyebrow={c.basics.eyebrow} headline={c.basics.headline} />
      <div class="basics-grid">{c.basics.items.map(item=><article class="basic-tile"><Icon name={item.icon} size={24} /><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
    </Section>
    <Section id="compare">
      <Heading headline={c.compare.headline} />
      <div class="compare-wrap"><table class="compare-table"><caption class="sr-only">Compare Mise with a typical POS and WhatsApp with a notebook</caption><thead><tr>{c.compare.columns.map((label,i)=><th scope="col" class:list={[{ 'mise-column':i===1 }]}>{label||<span class="sr-only">Feature</span>}</th>)}</tr></thead><tbody>{c.compare.rows.map(row=><tr><th scope="row">{row[0]}</th>{row.slice(1).map((value,i)=><td data-label={c.compare.columns[i+1]} class:list={[{ 'mise-column':i===0 }]}>{typeof value==='boolean'?<><Icon name={value?'check':'minus'} size={18} /><span class="sr-only">{value?'Included':'Not included'}</span></>:value}</td>)}</tr>)}</tbody></table></div>
    </Section>
    <Section id="cta" dark class="cta-section"><Heading headline={c.cta.headline} lead={c.cta.lead} /><div class="cta-actions"><a href={appUrl} class="button button-primary">{c.cta.primary}</a><a href={secondaryUrl || '#availability'} data-unconfigured={!secondaryUrl || undefined} class="button button-ghost"><Icon name="message" size={18} />{c.cta.secondary.label}</a>{secondaryUrl&&<><button class="copy-link" data-copy={secondaryUrl}>Copy link</button><button class="copy-link" data-mark-done>Mark done</button></>}</div></Section>
  </main>
  <Footer footer={c.footer} region={c.region} contactUrl={contactUrl} />
</Base>
