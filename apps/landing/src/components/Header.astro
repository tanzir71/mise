---
import type copy from '../../../../handover/copy/landing.bd.json';
import Icon from '@mise/ui/Icon.astro';
import RegionPicker from './RegionPicker.astro';
interface Props { nav: typeof copy.nav; appUrl: string; home?: string }
const { nav, appUrl, home = '#top' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<header class="site-header dark">
  <div class="container nav-inner">
    <a class="wordmark" href={home} aria-label="Mise home"><img src={`${base}brand/mise-mark-mono-white.svg`} width="32" height="32" alt="" /><span>mise</span><sup>®</sup></a>
    <nav class="desktop-nav" aria-label="Main navigation">{nav.links.map(link => <a href={link.href}>{link.label}</a>)}</nav>
    <div class="nav-actions"><RegionPicker label={nav.region} /><a class="sign-in" href={appUrl}>{nav.signIn}</a><a href={appUrl} class="button button-primary button-small">{nav.cta}<Icon name="arrowUpRight" size={14} /></a></div>
    <button class="menu-toggle" aria-label="Open navigation" aria-controls="mobile-nav"><Icon name="menu" size={24} /></button>
  </div>
</header>
<dialog id="mobile-nav" class="mobile-nav dark"><div class="mobile-nav-top"><span class="wordmark">mise</span><button class="menu-close" aria-label="Close navigation"><Icon name="x" size={24} /></button></div><nav aria-label="Mobile navigation">{nav.links.map(link => <a href={link.href}>{link.label}<Icon name="arrowUpRight" size={20} /></a>)}</nav><RegionPicker label={nav.region} /><a href={appUrl} class="button button-primary">{nav.cta}<Icon name="arrowRight" size={18} /></a></dialog>
<script>
  const menu = document.querySelector<HTMLDialogElement>('#mobile-nav');
  document.querySelector('.menu-toggle')?.addEventListener('click', () => menu?.showModal());
  document.querySelector('.menu-close')?.addEventListener('click', () => menu?.close());
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => menu.close()));
</script>
