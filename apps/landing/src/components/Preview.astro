---
import Icon from '@mise/ui/Icon.astro';
interface Props { mode?: string; phone?: boolean; region?: string; class?: string }
const { mode = 'live', phone = false, region = 'bd', class: className } = Astro.props;
const bd = region === 'bd';
const currency = bd ? '৳' : '$';
const store = bd ? 'Shorshe · Dhanmondi' : 'Saffron · Downtown';
const source = bd ? 'Foodpanda' : 'Uber Eats';
const wallet = bd ? 'bKash' : 'Stripe';
const titles: Record<string,string> = { live: 'Live store', orders: 'Orders', kitchen: 'Kitchen', stock: 'Stock', plan: 'Plan', team: 'Team', guests: 'Guests', credit: 'Counter', storefront: 'Your storefront', couriers: 'Parcels', start: 'Start service', tracking: 'Your order', today: 'Today', shop: 'Orders', stall: 'Today' };
const title = titles[mode] || 'Today';
const orders = [ { id:'A-2043',name:'Sadia Rahman',source,items:bd?'2× Kacchi, 1× Borhani':'2× Biryani, 1× Lassi',amount:'910',status:'Waiting',tone:'warning' }, { id:'A-2042',name:'Rafiq Ahmed',source:'WhatsApp',items:'1× Chicken bowl, 2× Rice',amount:'680',status:'Cooking',tone:'neutral' }, { id:'A-2041',name:'Nusrat Jahan',source:'QR · Table 4',items:'2× Set lunch',amount:'1,240',status:'Ready',tone:'positive' } ];
---
<div class:list={['product-preview', { 'phone-preview': phone, 'desktop-preview': !phone }, className]} aria-hidden="true">
  {phone ? <div class="phone-status"><b>9:41</b><span>● ▰ ▮</span></div> : <div class="browser-bar"><span class="browser-dots">● ● ●</span><span><Icon name="lock" size={10} /> app.mise.app</span><Icon name="more" size={14} /></div>}
  <div class="preview-shell">
    {!phone && <aside class="preview-sidebar"><div class="preview-logo">▧ mise</div><strong>{store.split(' · ')[0]} <Icon name="chevronDown" size={10} /></strong><small>{store.split(' · ')[1]}</small><div class="preview-nav">{[['home','Today'],['receipt','Orders'],['layers','Live store'],['package','Stock'],['calendar','Plan'],['users','Team'],['heart','Guests'],['scanLine','Capture']].map(([icon,label]) => <span class:list={[{ active:label===title }]}><Icon name={icon} size={13} />{label}</span>)}</div><div class="preview-health"><i /> All channels listening<small>Last checked just now</small></div></aside>}
    <div class="preview-main">
      <div class="preview-outlet"><span>{store} <Icon name="chevronDown" size={10} /></span><span><i /> Claude on</span><Icon name="bell" size={14} /></div>
      <div class="preview-title"><h3>{title}</h3><span>{mode==='live'?'Live · 19:44': mode==='orders'?'3 active':'Saturday, 15 November'}</span></div>
      {(mode==='live'||mode==='today'||mode==='stall') && <><div class="preview-stats"><div><small>Sales today</small><b>{currency}{bd?'42,680':'4,268'}</b><span>↑ 12% from last Saturday</span></div><div><small>Orders</small><b>68</b><span>3 waiting · 8 cooking</span></div><div><small>In the drawer</small><b>{currency}12,450</b><span>Count at close</span></div></div><div class="preview-alert"><Icon name="bell" size={16} /><div><strong>One order needs a look</strong><small>A-2043 · kitchen hasn’t seen it yet</small></div><span>View →</span></div><div class="preview-two"><div class="preview-panel"><div class="panel-top"><strong>Orders right now</strong><span>See all →</span></div>{orders.map(o => <div class="preview-order"><div><strong>{o.id}</strong><small>{o.source} · {o.name}</small></div><span class={`status-${o.tone}`}>{o.status}</span></div>)}</div><div class="preview-panel"><div class="panel-top"><strong>The rhythm of today</strong><small>Orders / hour</small></div><div class="mini-chart">{[24,42,36,78,96,64,48,70,87,55,40,28].map((height,i)=><div style={`height:${height}%`} class:list={[{ current:i===8 }]} />)}</div><div class="chart-axis"><span>11 am</span><span>3 pm</span><span>7 pm</span><span>11 pm</span></div></div></div><div class="preview-panel"><div class="panel-top"><strong>Everything in step</strong><span>Updated just now</span></div><div class="preview-grid-3"><div><Icon name="users" size={16} /><strong>5 of 6 on duty</strong><small>Dinner shift</small></div><div><Icon name="package" size={16} /><strong>2 items running low</strong><small>Chicken · Cooking oil</small></div><div><Icon name="wallet" size={16} /><strong>{wallet} matched</strong><small>All payments accounted for</small></div></div></div></>}
      {(mode==='orders'||mode==='shop') && <><div class="preview-tabs"><span class="active">Active <b>3</b></span><span>Done today</span><Icon name="search" size={14} /></div>{orders.map(o=><div class="preview-ticket"><div class="panel-top"><strong>{o.id}</strong><span class={`status-${o.tone}`}>● {o.status}</span></div><small>{o.source} · just now</small><h4>{o.name}</h4><p>{o.items}</p><div class="ticket-bottom"><strong>{currency}{o.amount}</strong><span>Paid · {wallet}</span><Icon name="arrowRight" size={14} /></div></div>)}</>}
      {mode==='kitchen' && <div class="kitchen-grid">{['New · 2','Cooking · 3','Ready · 1'].map((label,i)=><div><strong>{label}</strong>{orders.slice(0,i===1?2:1).map(o=><div class="preview-ticket"><div class="panel-top"><strong>{o.id}</strong><span>02:14</span></div><small>{o.source}</small><h4>{o.items}</h4><p>No extra spice</p><span class="preview-action">{i===0?'Got it':i===1?'Ready':'Picked up'}</span></div>)}</div>)}</div>}
      {mode==='stock' && <><div class="quick-update"><Icon name="mic" size={16} /><span>used 2 kg chicken</span><Icon name="arrowUp" size={16} /></div><div class="preview-tabs"><span class="active">All stock</span><span>Low · 2</span><span>Count</span></div><div class="stock-table"><div class="stock-row table-label"><span>Item</span><span>On hand</span><span>To order</span></div>{[['Chicken','4 kg','8 kg'],['Cooking oil','3 L','7 L'],['Basmati rice','24 kg','—'],['Onions','18 kg','—'],['Yoghurt','8 kg','—']].map((r,i)=><div class="stock-row"><div><strong>{r[0]}</strong><small>{i<2?'Below target':'Enough for today'}</small></div><span class:list={[{ 'status-warning':i<2 }]}>{r[1]}</span><strong>{r[2]}</strong></div>)}</div><div class="preview-panel"><Icon name="clipboard" size={16} /><strong> Supplier order is ready</strong><p>Review it, then send it your way.</p></div></>}
      {mode==='plan' && <><div class="preview-tabs"><span>Today</span><span class="active">Tomorrow</span><span>This week</span></div><div class="preview-panel"><strong>Saturday · dinner shift</strong><p>6 needed · 5 available</p><div class="staff-chart">{[42,48,64,80,96,88,60,40].map(height=><div style={`height:${height}%`} />)}</div><div class="chart-axis"><span>3 pm</span><span>6 pm</span><span>9 pm</span></div></div><div class="preview-alert"><Icon name="users" size={20} /><div><strong>Dinner is 1 person short</strong><small>Ask the team before the rush.</small></div></div><div class="preview-panel"><strong>Prep list · 3 pm</strong><p>✓ Marinate chicken · 8 kg</p><p>✓ Cook rice · 12 kg</p><p>○ Make borhani · 5 L</p></div></>}
      {mode==='team' && <><div class="preview-panel"><strong>Shorshe team <span class="muted">· 6 members</span></strong><div class="chat-message">Karim<small>আমি চলে এসেছি</small><span>10:40 ✓✓</span></div><div class="chat-message reply"><Icon name="checkCircle" size={14} /> Karim checked in<small>Morning shift · on time</small></div><div class="chat-message">Nila<small>Chicken almost out. About 4 kg left.</small><span>16:08</span></div><div class="chat-message reply">Stock note saved<small>Chicken · 4 kg on hand</small></div></div><div class="preview-panel"><strong>On duty · 5</strong>{['Karim','Nila','Rafiq'].map(n=><div class="preview-order"><span class="avatar">{n[0]}</span><strong>{n}</strong><span class="status-positive">● Here</span></div>)}</div></>}
      {mode==='guests' && <><div class="preview-stats"><div><small>Regular guests</small><b>284</b><span>Across every channel</span></div><div><small>Drifting away</small><b>62</b><span>Time for a hello</span></div></div><div class="preview-tabs"><span>All guests</span><span class="active">Win-back · 62</span></div>{['Sadia Rahman','Arif Hasan','Nusrat Jahan'].map((n,i)=><div class="preview-panel guest-row"><span class="avatar">{n[0]}</span><div><strong>{n}</strong><small>{12+i*4} orders · last seen {31+i} days ago</small><p>Favourite: {i===0?'Kacchi':'Chicken bowl'}</p></div><Icon name="message" size={18} /></div>)}</>}
      {mode==='credit' && <><div class="calculator-display"><small>COUNTER · CASH FIRST</small><span>120 + 85 + 40</span><b>{currency}245</b></div><div class="calculator-keys">{['7','8','9','÷','4','5','6','×','1','2','3','−','C','0','.','+'].map(key=><span>{key}</span>)}</div><div class="preview-action">✓ Record cash · {currency}245</div><div class="credit-option">Put on {bd?'khata':'tab'} <Icon name="arrowRight" size={14} /></div><div class="preview-panel"><strong>Akter apa</strong><p>{currency}755 remaining · within limit</p></div></>}
      {mode==='tracking' && <><div class="tracking-icon"><Icon name="utensils" size={32} /></div><h4 class="tracking-title">Good food takes a little care.</h4><p class="tracking-note">Your order is in the kitchen.</p><div class="preview-panel"><div class="panel-top"><strong>A-2043</strong><span>{currency}910</span></div><p>2× {bd?'Kacchi':'Biryani'}, 1× {bd?'Borhani':'Lassi'}</p></div><div class="tracking-steps">{['Order confirmed','In the kitchen','Ready for pickup','On the way'].map((s,i)=><div class:list={[{ done:i<2 }]}><span>{i<2?'✓':i+1}</span><strong>{s}</strong></div>)}</div><div class="preview-panel"><small>Estimated arrival</small><h4>7:55–8:10 pm</h4><p>We’ll let you know if anything changes.</p></div></>}
      {mode==='storefront' && <><div class="store-banner"><Icon name="utensils" size={32} /><small>FRESH FROM OUR KITCHEN</small><h4>{bd?'Shorshe':'Saffron'}</h4><span>Good food. Your way.</span></div><div class="preview-tabs"><span class="active">Popular</span><span>Meals</span><span>Drinks</span></div>{[[bd?'Kacchi biryani':'Chicken biryani','390'],['Chicken bowl','280'],[bd?'Borhani':'Mango lassi','130']].map(([n,p])=><div class="menu-item"><div class="menu-thumb"><Icon name="utensils" size={22} /></div><div><strong>{n}</strong><small>Made fresh, every day</small><b>{currency}{p}</b></div><span class="menu-add">+</span></div>)}</>}
      {mode==='couriers' && <><div class="preview-stats"><div><small>Ready to ship</small><b>6</b><span>All buyers confirmed</span></div><div><small>COD to collect</small><b>{currency}12,840</b><span>Across 3 couriers</span></div></div><div class="preview-tabs"><span class="active">To book · 6</span><span>On the way</span><span>Payouts</span></div>{['Rumana · Dhaka','Arif · Chattogram','Tania · Sylhet'].map((n,i)=><div class="preview-panel"><div class="panel-top"><strong>#{8812+i}</strong><span class="status-positive">✓ Confirmed</span></div><h4>{n}</h4><small>{bd?'Steadfast':'DHL'} · COD {currency}1,450</small><div class="ticket-bottom"><span>1 parcel · 0.5 kg</span><span>Book →</span></div></div>)}</>}
      {mode==='start' && <><div class="preview-panel"><strong>Ready for a good shift?</strong><p>7 of 8 channels are ready.</p><div class="readiness"><span /></div></div>{[[source,'Signed in'],['WhatsApp','Listening'],[wallet,'Listening'],[bd?'Pathao':'DoorDash','Needs sign-in'],['Kitchen tablet','Connected'],['Order phone','Connected']].map(([n,s])=><div class="preview-order"><Icon name={s==='Needs sign-in'?'alertCircle':'checkCircle'} size={16} /><strong>{n}</strong><span class:list={[s==='Needs sign-in'?'status-warning':'status-positive']}>{s}</span></div>)}<div class="preview-action">Start service <Icon name="arrowRight" size={14} /></div></>}
    </div>
  </div>
  {phone && <div class="phone-bottom">{[['home','Today'],['receipt','Orders'],['message','Inbox'],['package','Stock'],['more','More']].map(([icon,label])=><span><Icon name={icon} size={15} />{label}</span>)}</div>}
</div>
