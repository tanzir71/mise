---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import copy from '../../../../handover/copy/landing.bd.json';
import '../styles/landing.css';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = { ...copy.nav, links: copy.nav.links.map(link => ({ ...link, href: `${base}bd/${link.href}` })) };
const appUrl = import.meta.env.PUBLIC_APP_URL || (import.meta.env.DEV ? `http://127.0.0.1:5173${base}app/` : `${base}app/`);
---
<Base title={`${title} — Mise`} description={description}><Header nav={nav} appUrl={appUrl} home={`${base}bd/`} /><main id="main" class="info-page container"><p class="eyebrow">A LITTLE MORE ORDER</p><h1>{title}</h1><p class="lead">{description}</p><div class="prose"><slot /></div></main><Footer footer={copy.footer} region="bd" contactUrl={import.meta.env.PUBLIC_WHATSAPP_URL} /></Base>
<style>.info-page{padding-top:80px;padding-bottom:96px;max-width:840px}.info-page h1{font-size:clamp(40px,6vw,64px);line-height:1.08;margin-bottom:24px}.prose{margin-top:48px}.prose :global(h2){font-size:26px;margin:40px 0 16px;scroll-margin-top:40px}.prose :global(p){margin:16px 0;color:#6f6f6c;font-size:16px;line-height:1.8}.prose :global(a){color:#141414}</style>
