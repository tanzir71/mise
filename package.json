{
  "name": "mise",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:landing": "pnpm --filter @mise/landing dev",
    "dev:web": "pnpm --filter @mise/web dev",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && pnpm --filter @mise/landing check",
    "test": "vitest run",
    "e2e": "playwright test",
    "screenshots": "node scripts/capture.mjs",
    "screenshots:og": "node scripts/capture-og.mjs",
    "quality:lighthouse": "node scripts/lighthouse.mjs",
    "qa:visual": "node scripts/qa-visual.mjs",
    "check:exports": "node handover/scripts/export-figma.mjs --check --only=landing",
    "check:marketing": "node scripts/check-marketing.mjs",
    "check:images": "node scripts/check-image-budgets.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "dexie": "4.4.7",
    "eslint": "^9.39.0",
    "eslint-plugin-astro": "^1.3.1",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "jsqr": "1.4.0",
    "lighthouse": "^12.8.2",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
