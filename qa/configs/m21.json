        "selector": "textarea[aria-label=\"Order message\"]",
        "value": "Name: Sadia\nPhone: ০১৭১২৩৪৫৪৮২\nPickup: Tomorrow morning\nPayment: bKash\n2 Rice\n1 Soap\n1 Eggs"
      },
      {
        "type": "click",
        "selector": "button:text-is(\"Review draft\")"
      }
    ]
  },
